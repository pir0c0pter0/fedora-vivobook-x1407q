# Fragmento do kernel R3 = fragmento do R2 (copiado em 16/11/2026) com LOCALVERSION -r3.
# Uma secao por pendencia do CONTEXTO-LIMPO. Tudo que podia ser =m ficou =m.

CONFIG_LOCALVERSION="-yoga-kalambo-r3"

# --- Firewall: firewalld (FirewallBackend=nftables) sai com status 3 sem NF_TABLES ---
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_REJECT_NETDEV=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_NETDEV=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_HASH=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_OSF=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_DUP_NETDEV=m
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NFT_DUP_IPV4=m
CONFIG_NFT_DUP_IPV6=m
CONFIG_NFT_BRIDGE_META=m
CONFIG_NFT_BRIDGE_REJECT=m
CONFIG_NFT_FLOW_OFFLOAD=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
# iptables-nft (podman/libvirt/docker antigos) sobre nf_tables
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_TCPMSS=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
# conntrack: NAT, marcas/zonas e helpers que os servicos do firewalld referenciam
CONFIG_NF_NAT=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_CONNTRACK_NETBIOS_NS=m
CONFIG_NF_CONNTRACK_SNMP=m
CONFIG_NF_CONNTRACK_SIP=m
CONFIG_NF_CONNTRACK_IRC=m
CONFIG_NF_CONNTRACK_H323=m
CONFIG_NF_CONNTRACK_PPTP=m
CONFIG_NF_CONNTRACK_AMANDA=m
CONFIG_NF_CONNTRACK_SANE=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_LOG=m

# --- Firmware: o kernel nao le .xz/.zst (linux-firmware do Fedora e quase todo .xz) ---
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# --- zram (zram-generator do Fedora; hoje desligado por systemd.zram=0) ---
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y

# --- cpufreq: suspeita registrada (mailbox do CPUCP como modulo) ---
CONFIG_QCOM_CPUCP_MBOX=y

# --- Tethering USB de celular (RNDIS/iPhone; NCM/ECM ja eram =m) ---
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_IPHETH=m

# --- Diagnostico de panic em teste remoto ---
CONFIG_PANIC_TIMEOUT=15
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# --- PCIe: pwrctrl/pwrseq embutidos tiram a dependencia de ordem de carga ---
# (PCI_PWRCTRL_PWRSEQ so aceita =y com o patch 0002, que lhe da um prompt)
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
