# Fragmento de config para o proximo build de kernel (R4): habilita
# /sys/power/pm_test, pm_print_times e pm_debug_messages, sem os quais o
# roteiro graduado de suspensao nao existe (o kernel em uso tem
# "# CONFIG_PM_DEBUG is not set"). Aplicar com scripts/kconfig/merge_config.sh.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# Device que travar no suspend/resume por mais de 60 s vira panic com
# backtrace em vez de travamento mudo.
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=60
