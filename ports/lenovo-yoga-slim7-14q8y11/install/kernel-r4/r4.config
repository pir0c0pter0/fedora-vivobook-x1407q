# Fragmento do kernel R4 do Yoga Slim 7 14Q8Y11, aplicado SOBRE o .config final do R3
# (kernel-out-r3/build/.config). Uma secao por pedido; tudo que podia ser =m ficou =m.

CONFIG_LOCALVERSION="-yoga-kalambo-r4"

# --- (2) ALSA sequencer: /usr/lib/modprobe.d/dist-alsa.conf faz
#     "install snd-pcm modprobe --ignore-install snd-pcm && modprobe snd-seq";
#     sem snd-seq.ko todo modprobe que puxa snd-pcm (snd_q6apm etc.) retorna erro.
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y

# --- (3) Bluetooth: LE (HoG, fones LE), RFCOMM (HFP/SPP), BNEP (PAN), perifericos HID ---
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_DEBUGFS=y
# HoG (teclado/mouse BLE) passa pelo bluetoothd -> /dev/uhid; AVRCP usa /dev/uinput
CONFIG_UHID=m
CONFIG_INPUT_UINPUT=m
CONFIG_HIDRAW=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_APPLE=m
CONFIG_HID_MICROSOFT=m
# bluetoothd (e iwd) usam AF_ALG: cmac(aes)/ecb(aes) para LE (IRK, assinatura, hash GATT)
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_AEAD=m

# --- (4) Depuracao para bring-up remoto ---
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WQ_WATCHDOG=y
# PANIC_ON_OOPS fica desligado; "oops=panic", "softlockup_panic=1", "hung_task_panic=1"
# continuam disponiveis na cmdline.
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y
CONFIG_DYNAMIC_DEBUG=y
# so eventos (trace_event=..., /sys/kernel/tracing), sem function tracer
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_ARM_SCMI_DEBUG_COUNTERS=y

# --- (6) Cameras: CAMSS/CCI/CSIPHY ja eram =m; sensores da coleta Windows
#     (OmniVision ov08x frontal, ST vd55g0 IR) e os comuns em notebooks ---
CONFIG_VIDEO_OV08X40=m
CONFIG_VIDEO_VD55G1=m
CONFIG_VIDEO_VD56G3=m
CONFIG_VIDEO_VGXY61=m
CONFIG_VIDEO_OV01A10=m
CONFIG_VIDEO_OV02C10=m
CONFIG_VIDEO_OV02E10=m
CONFIG_VIDEO_OV05C10=m
CONFIG_VIDEO_OV08D10=m
CONFIG_VIDEO_OV13B10=m
CONFIG_VIDEO_OV5675=m
CONFIG_VIDEO_OV7251=m
CONFIG_VIDEO_OV9282=m
CONFIG_VIDEO_OV9734=m
CONFIG_VIDEO_OG01A1B=m
CONFIG_VIDEO_OG0VE1B=m
CONFIG_VIDEO_HI556=m
CONFIG_VIDEO_HI846=m
CONFIG_VIDEO_HI847=m
CONFIG_VIDEO_HM1246=m
CONFIG_VIDEO_IMX208=m
CONFIG_VIDEO_IMX258=m
CONFIG_VIDEO_IMX355=m
CONFIG_VIDEO_IMX471=m
CONFIG_VIDEO_IMX576=m
CONFIG_VIDEO_S5K3M5=m
CONFIG_VIDEO_S5KJN5=m
CONFIG_VIDEO_GC05A2=m
CONFIG_VIDEO_GC08A3=m
CONFIG_VIDEO_T4KA3=m

# --- (8) Outros, so modulos novos (nao mudam o que ja foi validado) ---
# trava manual opcional do touchscreen pedida pela frente (so casa com "goodix,gt7986u")
CONFIG_I2C_HID_OF_GOODIX=m
