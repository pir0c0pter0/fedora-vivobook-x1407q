+/* Caller has disabled both channel and module gates. No field-name or
+ * timer-restart semantics are inferred: this mirrors qcpmic8480 0x140027370.
+ */
+static int diagnostic_windows_config(struct qcom_flash_led *led, bool prepare)
+{
+	struct qcom_flash_data *data = led->flash_data;
+	u32 value;
+	int rc;
+
+	if (!diagnostic_windows_ee67)
+		return 0;
+	if (!data->diagnostic_ee67)
+		return -ENODEV;
+	if (prepare) {
+		if (data->diagnostic_saved_valid)
+			return -EBUSY;
+		if (led->chan_count != 2 || led->chan_id[0] != 0 ||
+		    led->chan_id[1] != 3 || led->flash_current_ma > 50 ||
+		    !led->flash_current_ma || led->flash_timeout_ms != 10)
+			return -EINVAL;
+		rc = regmap_field_read(data->diagnostic_ee67, &data->diagnostic_saved);
+		if (rc)
+			return rc;
+		data->diagnostic_saved_valid = true;
+		dev_info(led->flash.led_cdev.dev, "diagnostic ee67 bit0 saved=%u\n",
+			 data->diagnostic_saved);
+	} else if (!data->diagnostic_saved_valid) {
+		return 0;
+	}
+
+	value = prepare ? 0 : data->diagnostic_saved;
+	rc = regmap_field_write(data->diagnostic_ee67, value);
+	if (rc)
+		return rc;
+	rc = regmap_field_read(data->diagnostic_ee67, &value);
+	if (rc)
+		return rc;
+	if (value != (prepare ? 0 : data->diagnostic_saved))
+		return -EIO;
+	if (!prepare) {
+		data->diagnostic_saved_valid = false;
+		dev_info(led->flash.led_cdev.dev, "diagnostic ee67 bit0 restored=%u\n", value);
+	}
+	return 0;
+}
+
+static int diagnostic_external_off(struct qcom_flash_led *led)
+{
+	struct qcom_flash_data *data = led->flash_data;
+	u32 channels, module;
+	int rc, module_rc;
+
+	/* Attempt both OFF gates even if one write fails. */
+	rc = set_flash_strobe(led, HW_STROBE, false);
+	module_rc = set_flash_module_en(led, false);
+	if (rc || module_rc)
+		return rc ? rc : module_rc;
+	if (!diagnostic_windows_ee67 || !data->diagnostic_saved_valid)
+		return 0;
+	/* Restore only after actual register readback proves both gates OFF. */
+	rc = regmap_field_read(data->r_fields[REG_CHAN_EN], &channels);
+	if (rc)
+		return rc;
+	rc = regmap_field_read(data->r_fields[REG_MODULE_EN], &module);
+	if (rc)
+		return rc;
+	if (channels || module)
+		return -EBUSY;
+	return diagnostic_windows_config(led, false);
+}
