[Unit]
Description=Yoga X2 Plus: cameras RGB/IR e iluminador inicialmente desligado
ConditionKernelCommandLine=yoga.camera=1
Requires=yoga-video.service yoga-usb3.service
After=yoga-video.service yoga-usb3.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/yoga-camera-up
TimeoutStartSec=45

[Install]
# USB3 ja e acionado por udev depois da placa Wi-Fi; nao antecipar esse fluxo.
WantedBy=yoga-usb3.service
