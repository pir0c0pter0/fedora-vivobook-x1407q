+	u32 vco_tune1_mode0;
+	u32 vco_tune2_mode0;
 	u32 hsclk_sel;
 
 	switch (dp_opts->link_rate) {
 	case 1620:
+		/* VCO 12.96 GHz / 8, as qmp_v8_dp_serdes_tbl_rbr; untested */
 		hsclk_sel = 0x5;
-		dec_start_mode0 = 0x34;
-		div_frac_start2_mode0 = 0xc0;
-		div_frac_start3_mode0 = 0x0b;
+		dec_start_mode0 = 0x54;
+		div_frac_start2_mode0 = 0x00;
+		div_frac_start3_mode0 = 0x06;
 		lock_cmp1_mode0 = 0x37;
 		lock_cmp2_mode0 = 0x04;
-		code1_mode0 = 0x71;
-		code2_mode0 = 0x0c;
+		code1_mode0 = 0x8d;
+		code2_mode0 = 0x27;
+		vco_tune1_mode0 = 0xfe;
+		vco_tune2_mode0 = 0x00;
 		break;
 
 	case 2700:
-		hsclk_sel = 0x3;
-		dec_start_mode0 = 0x34;
-		div_frac_start2_mode0 = 0xc0;
-		div_frac_start3_mode0 = 0x0b;
+		/* VCO 10.8 GHz / 4, as qmp_v8_dp_serdes_tbl_hbr; untested */
+		hsclk_sel = 0x4;
+		dec_start_mode0 = 0x46;
+		div_frac_start2_mode0 = 0x00;
+		div_frac_start3_mode0 = 0x05;
 		lock_cmp1_mode0 = 0x07;
 		lock_cmp2_mode0 = 0x07;
-		code1_mode0 = 0x71;
-		code2_mode0 = 0x0c;
+		code1_mode0 = 0xf6;
+		code2_mode0 = 0x20;
+		vco_tune1_mode0 = 0xae;
+		vco_tune2_mode0 = 0x02;
 		break;
 
 	case 5400:
+		/* VCO 10.8 GHz / 2, as qmp_v8_dp_serdes_tbl_hbr2 and the firmware */
+		hsclk_sel = 0x3;
+		dec_start_mode0 = 0x46;
+		div_frac_start2_mode0 = 0x00;
+		div_frac_start3_mode0 = 0x05;
+		lock_cmp1_mode0 = 0x10;
+		lock_cmp2_mode0 = 0x0e;
+		code1_mode0 = 0xf6;
+		code2_mode0 = 0x20;
+		vco_tune1_mode0 = 0xae;
+		vco_tune2_mode0 = 0x02;
+		break;
+
 	case 8100:
 		hsclk_sel = 0x2;
 		dec_start_mode0 = 0x4f;
@@ -987,6 +1025,8 @@
 		lock_cmp2_mode0 = 0x15;
 		code1_mode0 = 0x14;
 		code2_mode0 = 0x25;
+		vco_tune1_mode0 = 0xa0;
