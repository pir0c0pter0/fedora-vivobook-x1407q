From: X1407QA hardware recovery <local@x1407qa.invalid>
Subject: [PATCH] PCI: qcom: diagnose PERST-before-WCN power ordering

Linux 7.2 powers PCI pwrctrl consumers before deasserting PERST#. The
previous lifecycle powered the WCN endpoint only after the controller had
released PERST#. Move only the power-on call so a diagnostic build can test
that ordering while retaining the Linux 7.2 pwrctrl ownership model.

This is a machine-specific diagnostic patch, not a proposed upstream fix.
---
 drivers/pci/controller/dwc/pcie-qcom.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
index d8eb52857f69..30097ac06a6b 100644
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -1380,16 +1380,10 @@ static int qcom_pcie_host_init(struct dw_pcie_rp *pp)
 			goto err_disable_phy;
 	}
 
-	if (!pp->skip_pwrctrl_off) {
-		ret = pci_pwrctrl_power_on_devices(pci->dev);
-		if (ret)
-			goto err_pwrctrl_destroy;
-	}
-
 	if (pcie->cfg->ops->post_init) {
 		ret = pcie->cfg->ops->post_init(pcie);
 		if (ret)
-			goto err_pwrctrl_power_off;
+			goto err_pwrctrl_destroy;
 	}
 
 	qcom_pcie_clear_aspm_l0s(pcie->pci);
@@ -1403,6 +1397,17 @@ static int qcom_pcie_host_init(struct dw_pcie_rp *pp)
 
 	qcom_pcie_perst_deassert(pcie);
 
+	if (!pp->skip_pwrctrl_off) {
+		ret = pci_pwrctrl_power_on_devices(pci->dev);
+		if (ret) {
+			qcom_pcie_perst_assert(pcie);
+			goto err_pwrctrl_destroy;
+		}
+
+		dev_info(pci->dev,
+			 "X1407QA Wi-Fi diagnostic: PERST# deasserted before WCN power-on\n");
+	}
+
 	if (pcie->cfg->ops->config_sid) {
 		ret = pcie->cfg->ops->config_sid(pcie);
 		if (ret)
-- 
