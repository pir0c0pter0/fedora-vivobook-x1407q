[Unit]
Description=ASUS Vivobook X1407QA RGB Camera (OV02C10)
# Load only after the core modules and graphical input stack are ready, because
# the camera overlay adds dynamically numbered CCI I2C adapters.
After=systemd-modules-load.service display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Load dependencies + camera module
ExecStart=/sbin/modprobe system_heap
ExecStart=/sbin/modprobe camcc_x1e80100
ExecStart=/sbin/modprobe i2c_qcom_cci
ExecStart=/sbin/modprobe qcom_camss
ExecStart=/sbin/modprobe ov02c10
ExecStart=/sbin/modprobe vivobook_cam_fix

# Module initialization synchronously creates and pins these devices.
ExecStartPost=/bin/sh -c 'for p in /sys/devices/platform/soc@0/ade0000.clock-controller /sys/devices/platform/soc@0/acb7000.isp /sys/devices/platform/soc@0/ac15000.cci /sys/devices/platform/soc@0/ac16000.cci; do [ -e "$p/power/control" ] && echo on > "$p/power/control"; done'

# NOTE: rmmod is dangerous (CAMCC GDSC corruption) — stop = no-op, reboot to unload
ExecStop=/bin/true

[Install]
WantedBy=graphical.target
